[Unit]
Description=NCT6687D hardware monitoring kernel module
Documentation=https://github.com/Fred78290/nct6687d
After=systemd-modules-load.service
# Only start after basic system is ready
After=basic.target sysinit.target
Before=multi-user.target

[Service]
# Ensure the akmod-compiled module is loaded; modprobe fails if the
# module is missing, which is the correct behavior (the service stays
# stopped until the module exists after the first boot)
Type=oneshot
ExecStart=/sbin/modprobe nct6687
RemainAfterExit=yes

# Unload module on stop
ExecStopPost=-/sbin/modprobe -r nct6687

# Timeouts
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
